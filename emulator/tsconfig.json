{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom"],
    "strict": true,
    "skipLibCheck": true,
    // Vite transpiles each file on its own with esbuild and never type-checks, so the
    // sources have to be safe to compile in isolation. Type checking is `npm run
    // typecheck`, which emits nothing.
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
