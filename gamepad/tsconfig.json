{
  "compilerOptions": {
    "target": "es2021",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2021", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    // Lit's decorators assign in the constructor, which is incompatible with the
    // [[Define]] class-field semantics. This is already the default at this target, but
    // it is pinned so raising target to ES2022 or later cannot silently break them.
    "useDefineForClassFields": false,
    // Vite transpiles each file on its own with esbuild and never type-checks, so the
    // sources have to be safe to compile in isolation. Type checking is `npm run
    // typecheck`, which emits nothing.
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
